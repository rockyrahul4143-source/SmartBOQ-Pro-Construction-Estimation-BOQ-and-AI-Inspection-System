# ============================================================
# SmartBOQ Pro - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=SmartBOQ Pro
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=smartboq
POSTGRES_USER=smartboq_user
POSTGRES_PASSWORD=smartboq_password
DATABASE_URL=postgresql://smartboq_user:smartboq_password@db:5432/smartboq

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=SmartBOQ Pro

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email (for password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@smartboq.com
EMAILS_FROM_NAME=SmartBOQ Pro

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
